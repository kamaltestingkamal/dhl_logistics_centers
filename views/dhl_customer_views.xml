<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dhl_customer_list" model="ir.ui.view">
        <field name="name">dhl.customer.list</field>
        <field name="model">dhl.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_name" optional="show"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="order_count"/>
                <field name="shipment_count"/>
            </list>
        </field>
    </record>
    <record id="view_dhl_customer_form" model="ir.ui.view">
        <field name="name">dhl.customer.form</field>
        <field name="model">dhl.customer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_view_orders" icon="fa-shopping-basket">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button class="oe_stat_button" type="object" name="action_view_shipments" icon="fa-truck">
                            <field name="shipment_count" widget="statinfo" string="Shipments"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Customer name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                        </group>
                        <group>
                            <field name="amazon_buyer_ref"/>
                            <field name="source"/>
                            <field name="marketplace"/>
                            <field name="last_sync_at" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Addresses" name="addresses">
                            <field name="address_ids">
                                <list>
                                    <field name="label"/>
                                    <field name="address_type"/>
                                    <field name="street"/>
                                    <field name="street_number"/>
                                    <field name="zip"/>
                                    <field name="city"/>
                                    <field name="country_id"/>
                                    <field name="is_default"/>
                                    <field name="validation_state" widget="badge" decoration-success="validation_state == 'valid'" decoration-danger="validation_state == 'invalid'" decoration-muted="validation_state == 'not_validated'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dhl_customer_search" model="ir.ui.view">
        <field name="name">dhl.customer.search</field>
        <field name="model">dhl.customer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('email', 'ilike', self), ('company_name', 'ilike', self)]"/>
                <field name="amazon_buyer_ref"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_dhl_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">dhl.customer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first customer</p>
            <p>Customers hold the delivery addresses used on orders and shipments.</p>
        </field>
    </record>
    <record id="action_dhl_customer_new" model="ir.actions.act_window">
        <field name="name">New Customer</field>
        <field name="res_model">dhl.customer</field>
        <field name="view_mode">form</field>
    </record>

    <record id="view_dhl_address_list" model="ir.ui.view">
        <field name="name">dhl.customer.address.list</field>
        <field name="model">dhl.customer.address</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_id"/>
                <field name="label"/>
                <field name="street"/>
                <field name="street_number"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="is_default"/>
                <field name="validation_state" widget="badge" decoration-success="validation_state == 'valid'" decoration-danger="validation_state == 'invalid'" decoration-muted="validation_state == 'not_validated'"/>
            </list>
        </field>
    </record>
    <record id="view_dhl_address_form" model="ir.ui.view">
        <field name="name">dhl.customer.address.form</field>
        <field name="model">dhl.customer.address</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="label"/>
                            <field name="address_type"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="contact_name"/>
                            <field name="company_name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="street"/>
                            <field name="street_number"/>
                            <field name="address_line2"/>
                        </group>
                        <group>
                            <field name="zip"/>
                            <field name="city"/>
                            <field name="state_name"/>
                            <field name="country_id"/>
                            <field name="validation_state"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dhl_address" model="ir.actions.act_window">
        <field name="name">Addresses</field>
        <field name="res_model">dhl.customer.address</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
