<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dhl_notification_list" model="ir.ui.view">
        <field name="name">dhl.notification.list</field>
        <field name="model">dhl.notification</field>
        <field name="arch" type="xml">
            <list decoration-bf="not is_read" decoration-muted="is_read">
                <field name="create_date" string="When"/>
                <field name="notification_type" widget="badge" decoration-success="notification_type == 'success'" decoration-danger="notification_type == 'error'" decoration-warning="notification_type == 'warning'" decoration-info="notification_type == 'info'"/>
                <field name="name"/>
                <field name="message"/>
                <field name="record_name"/>
                <field name="user_id" groups="dhl_logistics_center.group_dhl_manager"/>
                <field name="is_read" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dhl_notification_form" model="ir.ui.view">
        <field name="name">dhl.notification.form</field>
        <field name="model">dhl.notification</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_record" string="Open Related Record" type="object" class="btn-primary" invisible="not res_id"/>
                    <button name="action_mark_read" string="Mark as Read" type="object" invisible="is_read"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="notification_type"/>
                            <field name="record_name"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="is_read"/>
                            <field name="create_date"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dhl_notification_search" model="ir.ui.view">
        <field name="name">dhl.notification.search</field>
        <field name="model">dhl.notification</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="message"/>
                <field name="record_name"/>
                <filter name="unread" string="Unread" domain="[('is_read', '=', False)]"/>
                <filter name="errors" string="Errors" domain="[('notification_type', '=', 'error')]"/>
                <filter name="warnings" string="Warnings" domain="[('notification_type', '=', 'warning')]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'notification_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dhl_notification" model="ir.actions.act_window">
        <field name="name">Notifications</field>
        <field name="res_model">dhl.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unread': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">You're all caught up</p>
            <p>Important events and errors from DHL operations appear here and stay until you read them.</p>
        </field>
    </record>
</odoo>
