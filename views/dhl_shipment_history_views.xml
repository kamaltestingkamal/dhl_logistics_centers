<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dhl_shipment_history_list" model="ir.ui.view">
        <field name="name">dhl.shipment.history.list</field>
        <field name="model">dhl.shipment.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="shipment_id"/>
                <field name="event_type"/>
                <field name="message"/>
                <field name="old_state"/>
                <field name="new_state"/>
                <field name="user_id"/>
                <field name="automatic" widget="badge" decoration-success="automatic == True"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_dhl_shipment_history_form" model="ir.ui.view">
        <field name="name">dhl.shipment.history.form</field>
        <field name="model">dhl.shipment.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="shipment_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="automatic" readonly="1"/>
                        </group>
                        <group>
                            <field name="old_state" readonly="1"/>
                            <field name="new_state" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Related Tracking" invisible="not related_tracking_id">
                        <field name="related_tracking_id" readonly="1"/>
                        <field name="tracking_status_text" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dhl_shipment_history_search" model="ir.ui.view">
        <field name="name">dhl.shipment.history.search</field>
        <field name="model">dhl.shipment.history</field>
        <field name="arch" type="xml">
            <search/>
        </field>
    </record>

    <record id="action_dhl_shipment_history" model="ir.actions.act_window">
        <field name="name">Shipment History</field>
        <field name="res_model">dhl.shipment.history</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No history yet</p>
            <p>History is automatically recorded when shipments are created, updated, or change state.</p>
        </field>
    </record>
</odoo>
