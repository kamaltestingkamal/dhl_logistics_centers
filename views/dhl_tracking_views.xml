<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dhl_tracking_list" model="ir.ui.view">
        <field name="name">dhl.tracking.list</field>
        <field name="model">dhl.tracking</field>
        <field name="arch" type="xml">
            <list>
                <field name="event_time"/>
                <field name="shipment_id"/>
                <field name="tracking_number"/>
                <field name="status_text"/>
                <field name="normalized_status" widget="badge" decoration-success="normalized_status == 'delivered'" decoration-danger="normalized_status in ('delivery_failed', 'exception', 'returned')" decoration-primary="normalized_status in ('in_transit', 'out_for_delivery')"/>
                <field name="location"/>
                <field name="source"/>
            </list>
        </field>
    </record>
    <record id="view_dhl_tracking_form" model="ir.ui.view">
        <field name="name">dhl.tracking.form</field>
        <field name="model">dhl.tracking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="shipment_id"/>
                            <field name="event_time"/>
                            <field name="status_text"/>
                            <field name="status_code"/>
                        </group>
                        <group>
                            <field name="normalized_status"/>
                            <field name="location"/>
                            <field name="source"/>
                        </group>
                    </group>
                    <group string="Raw payload" invisible="not raw_payload"><field name="raw_payload" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_dhl_tracking_search" model="ir.ui.view">
        <field name="name">dhl.tracking.search</field>
        <field name="model">dhl.tracking</field>
        <field name="arch" type="xml">
            <search>
                <field name="tracking_number"/>
                <field name="shipment_id"/>
                <field name="status_text"/>
                <filter name="f_delivered" string="Delivered" domain="[('normalized_status', '=', 'delivered')]"/>
                <filter name="f_exceptions" string="Exceptions" domain="[('normalized_status', 'in', ('delivery_failed', 'exception', 'returned'))]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'normalized_status'}"/>
                    <filter name="group_shipment" string="Shipment" context="{'group_by': 'shipment_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_dhl_tracking" model="ir.actions.act_window">
        <field name="name">Tracking History</field>
        <field name="res_model">dhl.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">No tracking events</p><p>Events arrive from the scheduled DHL tracking sync. You can add one manually to test status changes.</p></field>
    </record>
    <record id="action_dhl_tracking_exceptions" model="ir.actions.act_window">
        <field name="name">Tracking Exceptions</field>
        <field name="res_model">dhl.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('normalized_status', 'in', ('delivery_failed', 'exception', 'returned'))]</field>
    </record>
    <record id="action_dhl_tracking_delivered" model="ir.actions.act_window">
        <field name="name">Delivered (Tracking)</field>
        <field name="res_model">dhl.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('normalized_status', '=', 'delivered')]</field>
    </record>
</odoo>
